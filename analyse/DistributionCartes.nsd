<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-34" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="mgams" created="2026-03-03" changedby="mgams" changed="2026-05-01" origin="Structorizer 3.32-34" text="&#34;DistributionCartes&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<instruction text="&#34;indexPaquet = 0&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<alternative text="&#34;jeuCartes.length &#60; 15&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;OUTPUT Le paquet doit contenir au moins 15 cartes.&#34;" comment="&#34;&#34;" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse color="ffffff">
			</qFalse>
		</alternative>
		<instruction text="&#34;mainJoueur = new string[7]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;mainOrdinateur = new string[7]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;indexPaquet = 0&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<for text="&#34;for iCarte = 0 to 6 ; iCarte++ ;&#34;" comment="" counterVar="dummy_counter" startValue="iCarte = 0" endValue="6 ; iCarte++ ;" stepConst="1" style="FREETEXT" color="ffffff" disabled="0">
			<qFor>
				<instruction text="&#34;mainJoueur[iCarte] = jeuCartes[indexPaquet]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;indexPaquet++&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;mainOrdinateur[iCarte] = jeuCartes[indexPaquet]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;indexPaquet++&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qFor>
		</for>
		<instruction text="&#34;carteTable = jeuCartes[indexPaquet]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<instruction text="&#34;indexPaquet++&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
		<while text="&#34;while EstCarteSpecialeDepart(carteTable) AND indexPaquet &#60; jeuCartes.length&#34;" comment="" color="ffffff" disabled="0">
			<qWhile>
				<instruction text="&#34;carteTable = jeuCartes[indexPaquet]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<instruction text="&#34;indexPaquet++&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qWhile>
		</while>
		<alternative text="&#34;EstCarteSpecialeDepart(carteTable)&#34;" comment="" color="ffffff" branch_colors="," disabled="0">
			<qTrue>
				<instruction text="&#34;carteTable = &#34;&#34;Rouge 0&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
			</qTrue>
			<qFalse color="ffffff">
			</qFalse>
		</alternative>
	</children>
</root>