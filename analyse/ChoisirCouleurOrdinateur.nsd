<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:nsd="https://structorizer.fisch.lu" version="3.32-34" preRepeat="until " postFor="to" preReturn="return" postForIn="in" preWhile="while " output="OUTPUT" input="INPUT" preFor="for" preExit="exit" preLeave="leave" ignoreCase="true" preThrow="throw" preForIn="foreach" stepFor="by" author="mgams" created="2026-05-01" changedby="codex" changed="2026-05-01" origin="Structorizer 3.32-34" text="&#34;ChoisirCouleurOrdinateur&#34;" comment="" color="ffffff" type="program" style="nice">
	<children>
		<for text="&#34;for iCarte = 0 to mainOrdinateur.length - 1 ; iCarte++ ;&#34;" comment="" counterVar="dummy_counter" startValue="iCarte = 0" endValue="mainOrdinateur.length - 1 ; iCarte++ ;" stepConst="1" style="FREETEXT" color="ffffff" disabled="0">
			<qFor>
				<instruction text="&#34;couleur = mainOrdinateur[iCarte].Split(' ')[0]&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
				<alternative text="&#34;couleur = &#34;&#34;Rouge&#34;&#34; OR couleur = &#34;&#34;Bleu&#34;&#34; OR couleur = &#34;&#34;Vert&#34;&#34; OR couleur = &#34;&#34;Jaune&#34;&#34;&#34;" comment="" color="ffffff" disabled="0">
					<qTrue>
						<instruction text="&#34;return couleur&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
					</qTrue>
					<qFalse>
					</qFalse>
				</alternative>
			</qFor>
		</for>
		<instruction text="&#34;return &#34;&#34;Rouge&#34;&#34;&#34;" comment="" color="ffffff" rotated="0" disabled="0"></instruction>
	</children>
</root>
